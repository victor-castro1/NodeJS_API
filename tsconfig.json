{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    
    "target": "es2016",

    "module": "commonjs",

    "outDir": "dist",                         // Aqui diz ao TypeScript, onde irar colocar os arquivos, depois da compilação  
    "rootDir": "src",                         // Diz ao TypeScript, onde estão os arquivos iniciais, O compilador só irar olhar para ela

    "esModuleInterop": true,

    "forceConsistentCasingInFileNames": true,

    "strict": true,

    "skipLibCheck": true
  }
}
